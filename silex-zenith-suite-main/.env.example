# ==============================================================================
# SILEX 2.0 — Production & Development Environment Configuration
# ==============================================================================
# Architecture: TanStack Start (SSR) + PostgreSQL (Drizzle ORM) + Supabase Auth
# Design Philosophy: Student-Friendly, Low-Cost / $0 Infrastructure Defaults
#
# IMPORTANT SECURITY RULES:
# 1. Variables prefixed with VITE_ are bundled into client-side code and public.
# 2. Variables WITHOUT VITE_ prefix are SERVER-ONLY and must never reach the browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / CLIENT-SIDE VARIABLES (Browser-Accessible)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Anonymous API Key (publicly safe JWT client key)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Storage Mode Indicator (optional, defaults to "disabled" for $0 metadata-only mode)
# Options: "disabled" | "local" | "supabase"
VITE_STORAGE_MODE=disabled

# Base Application URL (used for OAuth redirects and canonical links)
VITE_APP_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# 2. SERVER-ONLY DATABASE CONFIGURATION (Private Secret)
# ------------------------------------------------------------------------------
# PostgreSQL Connection String
# For Supabase: Use Transaction Pooler (port 6543) for serverless/pooler compatibility
# Format: postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR_DB_PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Maximum concurrent connections per serverless instance (defaults to 10)
DB_MAX_CONNECTIONS=10


# ------------------------------------------------------------------------------
# 3. SERVER-ONLY STORAGE & MEDIA CONFIGURATION
# ------------------------------------------------------------------------------
# Storage Provider Mode:
# - "disabled": (Default, $0 cost) Stores attachment metadata in PostgreSQL; no cloud buckets needed.
# - "local": Stores files in a local sandboxed directory (useful for offline dev).
# - "supabase": Production cloud storage using Supabase Storage buckets ("silex-documents", "silex-avatars").
STORAGE_MODE=disabled

# Local storage sandbox directory (only used when STORAGE_MODE=local)
LOCAL_STORAGE_DIR=.storage_local

# Supabase Service Role Key (optional, only needed for STORAGE_MODE=supabase admin operations)
# NEVER expose this key to the browser!
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------------------
# 4. SERVER-ONLY AUTOMATION & WORKER CRON SCHEDULING (Private Secret)
# ------------------------------------------------------------------------------
# Shared secret for authenticating automated background cron workers:
# - triggerAutomationOutboxWorkerFn
# - triggerWebhookDeliveryWorkerFn
# Inbound requests must provide: "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=your-random-32-character-cron-secret-here


# ------------------------------------------------------------------------------
# 5. SERVER-ONLY AI ZENITH STUDIO CONFIGURATION
# ------------------------------------------------------------------------------
# Provider Selection: "gemini" | "openai" (defaults to "gemini")
# If no key is provided, AI Zenith gracefully falls back to MockAIProvider ($0 cost)
AI_PROVIDER=gemini

# Google Gemini API Key (get free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# Model Names
AI_MODEL=gemini-3.6-flash
AI_EMBEDDING_MODEL=gemini-embedding-001


# ------------------------------------------------------------------------------
# 6. SERVER-ONLY PAYMENTS & BILLING (Optional Production Secrets)
# ------------------------------------------------------------------------------
# Stripe Secret Key (if omitted, SILEX operates in built-in $0 transactional simulation mode)
STRIPE_SECRET_KEY=

# Stripe Webhook Endpoint Secret (for verifying inbound webhook HMAC signatures)
STRIPE_WEBHOOK_SECRET=

# Public Canonical URL for Stripe checkout redirects (e.g. https://your-domain.com)
APP_URL=http://localhost:3000
